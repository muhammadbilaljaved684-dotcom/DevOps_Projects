# Copy to terraform.tfvars (git-ignored) and fill in.
owner        = "you@example.com"
github_owner = "muhammadbilaljaved684-dotcom"
state_bucket = "labops-tfstate-123456789012"
budget_email = "you@example.com"

# Check what is in standard support today:
#   aws eks describe-cluster-versions --default-only --query 'clusterVersions[].clusterVersion'
kubernetes_version = "1.34"

api_allowed_cidrs   = ["203.0.113.10/32"]
admin_principal_arns = ["arn:aws:iam::123456789012:user/you"]

# Cheap demo profile: 2 AZs, 1 NAT, spot nodes. Destroy when not demoing.
az_count           = 2
single_nat_gateway = true
node_capacity_type = "SPOT"
node_desired       = 3
