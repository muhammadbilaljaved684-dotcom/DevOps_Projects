{
  "title": "LabOps – service overview & SLO",
  "uid": "labops-overview",
  "tags": ["labops", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(labops_jobs_total, namespace)",
        "refresh": 2
      },
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "SLO: good uploads (1h)",
      "description": "Share of uploads processed successfully within 30 s. Target 99%.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "1 - labops:sli_error_ratio:rate1h", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.98 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Error budget remaining (3-day window)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "clamp_min(1 - (labops:sli_error_ratio:rate3d / 0.01), 0)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Queue depth",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "max(labops_queue_depth{namespace=\"$namespace\"})", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Fault injection",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "max(labops_fault_mode_enabled{namespace=\"$namespace\"}) or vector(0)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "off", "color": "green" }, "1": { "text": "ACTIVE", "color": "red" } } }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Upload → result latency (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(labops_job_e2e_seconds_bucket{namespace=\"$namespace\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(labops_job_e2e_seconds_bucket{namespace=\"$namespace\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(labops_job_e2e_seconds_bucket{namespace=\"$namespace\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Jobs per second by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "expr": "sum by (outcome) (rate(labops_jobs_total{namespace=\"$namespace\"}[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "SLI error ratio vs. burn-rate thresholds",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "labops:sli_error_ratio:rate5m", "legendFormat": "5m", "refId": "A" },
        { "expr": "labops:sli_error_ratio:rate1h", "legendFormat": "1h", "refId": "B" },
        { "expr": "vector(0.144)", "legendFormat": "fast-burn page (14.4x)", "refId": "C" },
        { "expr": "vector(0.06)", "legendFormat": "slow-burn page (6x)", "refId": "D" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Uploads by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (outcome) (rate(labops_uploads_total{namespace=\"$namespace\"}[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ]
    }
  ]
}
